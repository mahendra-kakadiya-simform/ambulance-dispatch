# Connection string for the local Postgres database
DATABASE_URL=postgresql://ambulance:ambulance@localhost:5432/ambulance_dispatch

# Port the Express server listens on
PORT=4000

# Runtime environment: development | test | production
NODE_ENV=development

# Secret used to sign JWTs — use a long random string, never commit a real value
JWT_SECRET=

# How long issued JWTs stay valid (e.g. 1h, 7d)
JWT_EXPIRES_IN=1h

# Allowed origin for CORS requests from the frontend (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Email used to seed the initial super admin account
SUPER_ADMIN_EMAIL=

# Password used to seed the initial super admin account
SUPER_ADMIN_PASSWORD=

# Display name used to seed the initial super admin account
SUPER_ADMIN_NAME=
