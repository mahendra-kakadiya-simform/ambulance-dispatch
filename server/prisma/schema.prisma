generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  DISPATCHER
  DRIVER
}

enum VehicleStatus {
  AVAILABLE
  OUT_OF_SERVICE
}

enum Urgency {
  CRITICAL
  URGENT
  ROUTINE
}

enum RequestState {
  REQUESTED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  SUPERSEDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle         Vehicle?
  createdRequests Request[]
  assignmentsMade Assignment[]
  auditEvents     AuditEvent[]

  @@map("users")
}

model Vehicle {
  id       String        @id @default(uuid()) @db.Uuid
  code     String        @unique
  status   VehicleStatus
  driverId String?       @unique @db.Uuid

  driver          User?                     @relation(fields: [driverId], references: [id])
  position        VehiclePosition?
  positionHistory VehiclePositionHistory[]
  assignments     Assignment[]

  @@map("vehicles")
}

// Current known position per vehicle, overwritten in place as new GPS pings arrive.
model VehiclePosition {
  vehicleId  String   @id @db.Uuid
  latitude   Float
  longitude  Float
  recordedAt DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_positions")
}

// Append-only log of every position ping, kept for playback/audit of a vehicle's route.
model VehiclePositionHistory {
  id         String   @id @default(uuid()) @db.Uuid
  vehicleId  String   @db.Uuid
  latitude   Float
  longitude  Float
  recordedAt DateTime

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  // Serves fetching a vehicle's movement trail in chronological order (route replay / history view).
  @@index([vehicleId, recordedAt])
  @@map("vehicle_position_history")
}

model Request {
  id          String       @id @default(uuid()) @db.Uuid
  patientName String
  address     String
  latitude    Float
  longitude   Float
  urgency     Urgency
  state       RequestState @default(REQUESTED)
  version     Int          @default(1)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy   User         @relation(fields: [createdById], references: [id])
  assignments Assignment[]

  @@map("requests")
}

model Assignment {
  id               String           @id @default(uuid()) @db.Uuid
  requestId        String           @db.Uuid
  vehicleId        String           @db.Uuid
  status           AssignmentStatus
  assignedById     String           @db.Uuid
  overriddenFromId String?          @db.Uuid
  overrideReason   String?
  createdAt        DateTime         @default(now())

  request        Request      @relation(fields: [requestId], references: [id])
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  assignedBy     User         @relation(fields: [assignedById], references: [id])
  overriddenFrom Assignment?  @relation("AssignmentOverride", fields: [overriddenFromId], references: [id])
  supersedes     Assignment[] @relation("AssignmentOverride")

  @@map("assignments")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  entityType String
  entityId   String
  action     String
  fromValue  String?
  toValue    String?
  reason     String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  // Serves fetching the audit trail for one specific entity (e.g. "show history for Request X").
  @@index([entityType, entityId])
  @@map("audit_events")
}
